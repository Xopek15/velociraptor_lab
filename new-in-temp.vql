

name: Custom.Detection.NewInTemp
description: Detect recently created files in Windows user TEMP directories
type: CLIENT

sources:
  - precondition: |
      SELECT OS FROM info() WHERE OS = 'windows'
    query: |
      SELECT
        OSPath,
        Size,
        Mtime,
        Btime
      FROM glob(globs="C:/Users/*/AppData/Local/Temp/*")
      WHERE Btime > now() - 3600
